services:

  postgres:
    image: postgres:16-alpine
    container_name: postgres
    restart: always
    expose:
      - 5432
    env_file:
      - ./config/cadence.env
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U $${POSTGRES_USER:-postgres}"]
      interval: 5s
      timeout: 3s
      retries: 10
    volumes:
      - postgres_data:/var/lib/postgresql/data
    networks:
      internal_services:

  liquidsoap:
    build:
      dockerfile: ./src/liquidsoap.Dockerfile
    image: kenellorando/cadence_liquidsoap:latest
    container_name: liquidsoap
    restart: always
    volumes:
      - ./config/liquidsoap.liq:/etc/liquidsoap/cadence.liq
      - CADENCE_PATH_EXAMPLE:CADENCE_PATH_EXAMPLE:ro
    depends_on:
      - cadence
    expose:
      - 1234
    networks:
      internal_services:

  cadence:
    build:
      context: ./src/
      dockerfile: ./cadence.Dockerfile
    image: kenellorando/cadence
    container_name: cadence
    restart: always
    ports:
      - 8080:8080
    # The audio source port is exposed to the other services but never
    # published: the source password should not be reachable from outside.
    expose:
      - 8081
    env_file:
      - ./config/cadence.env
    volumes:
      - CADENCE_PATH_EXAMPLE:CADENCE_PATH_EXAMPLE:ro
    depends_on:
      postgres:
        condition: service_healthy
    networks:
      internal_services:
      external_services:

NGINX_CONFIG_SECTION

volumes:
  postgres_data:

networks:
  external_services:
    driver: bridge
  internal_services:
    driver: bridge
